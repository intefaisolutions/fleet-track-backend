# App
NODE_ENV=development
PORT=3000
APP_NAME=FleetTrack
# CORS_ORIGIN=http://localhost:5173

# Public API URL (Swagger, callbacks)
APP_BASE_URL=http://192.168.1.9:3000
CORS_ORIGIN=http://10.215.106.230:5173

# Admin web app — emails (license register link, password reset page)
# Production: https://fleettrackservice.in  (no trailing slash)
ADMIN_APP_URL=https://fleettrackservice.in

# Optional path overrides (defaults match Fleet-admin routes)
# APP_PATH_SIGN_IN=/signin
# APP_PATH_REGISTER_COMPANY=/register-company
# APP_PATH_FORGOT_PASSWORD=/forgot-password

# Database
MONGODB_URI=mongodb://localhost:27017/fleet_saas

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Super Admin one-time setup
SUPER_ADMIN_SETUP_SECRET=your-setup-secret

# Google Sign-In (OAuth 2.0 Web client ID — same as VITE_GOOGLE_CLIENT_ID on admin)
GOOGLE_CLIENT_ID=

# License: days after validUntil that company users can still log in (default 7)
LICENSE_GRACE_PERIOD_DAYS=7

# -----------------------------------------------------------------------------
# Email — forgot-password OTP, license key, owner/driver welcome (nodemailer / SMTP)
# Gmail: use App Password — https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=FleetTrack

# -----------------------------------------------------------------------------
# Supabase Storage — fallback if AWS S3 is not set
# Dashboard: https://supabase.com/dashboard → Storage → New bucket "fleet-uploads" (Public)
# Use service_role key on backend ONLY — never put it in Fleet-admin / frontend
# -----------------------------------------------------------------------------
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fleet-uploads

# -----------------------------------------------------------------------------
# AWS S3 — company logos, receipts, vehicle photos, profile avatars (preferred)
# Bucket should allow public GetObject (or use CloudFront). IAM user needs s3:PutObject.
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=fleet-track-images
# AWS_S3_PUBLIC_READ=true
# Set true only after adding a public GetObject bucket policy. Default: private + presigned URLs.
AWS_S3_PUBLIC_READ=false

# -----------------------------------------------------------------------------
# Razorpay (optional — subscription upgrades)
# Keep KEY_SECRET on server only. Frontend uses KEY_ID via VITE_RAZORPAY_KEY_ID.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=
